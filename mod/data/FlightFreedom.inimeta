// INI Master metadata for FlightFreedom.ini, embedded in FlightFreedom.asi as
// the INIMETA resource (see src/resources.rc). Keep it in step with
// ReadSettings() in src/core/mod.cpp; scripts/check_inimeta.py compares the
// two and fails the release gate when they disagree.
//
// This is JSON rather than an annotated default ini. GroundCheck and
// LandedTimeout are keys the plugin reads that never appear in the shipped
// FlightFreedom.ini, so an annotated copy of that file would have no line to
// read their defaults from. The [sites], [patch] and [watch] sections add a
// second problem: players type their own keys into them, so there is no
// fixed list to annotate. JSON describes both without adding a single line
// to the ini players see.
{
  "inimeta": 1,
  "name": "Flight Freedom",
  "author": "Seth",
  "url": "https://www.nexusmods.com/crimsondesert/mods/3488",
  "ini": "FlightFreedom.ini",
  "live": false,
  "description": "Lifts the flying ceiling, the region no-fly list, the Abyss summon refusal and the town dismount in Crimson Desert, keeps Blackstar from flying off on his own about 30 seconds after landing, and takes away his hour-long summon cooldown. Every setting here is read once at startup; a change needs a restart.",
  "sections": {
    "settings": {
      "label": "Flight Freedom",
      "order": 1,
      "keys": {
        "Ceiling": {
          "label": "Flying ceiling",
          "type": "float",
          "default": "-1",
          "help": [
            "The flying ceiling. The game ships 1350 on Blackstar and the Wyvern and no ceiling on every other mount; this is written over the loaded table at startup and read back.",
            "0 leaves the game's 1350. -1 removes the ceiling. Any other number sets that height, for example 5000."
          ],
          "order": 1
        },
        "NoFlyZones": {
          "label": "Ignore region no-fly lists",
          "type": "bool",
          "default": "1",
          "true": "1",
          "false": "0",
          "help": "Regions carry a block list of mount categories. Flying into a region that lists your mount dismounts you, which is what happens at roughly 1550 up, and a ride into it is refused; the same list refuses an Abyss summon. On, no region blocks any mount.",
          "order": 2
        },
        "AbyssSummon": {
          "label": "Ignore the Abyss summon region refusal",
          "type": "bool",
          "default": "1",
          "true": "1",
          "false": "0",
          "help": "The summon validator's own region refusal (\"Cannot summon in this area.\"). Redundant while NoFlyZones is on; kept separate so summoning in the Abyss still works if NoFlyZones is turned off to keep the dismount zones.",
          "order": 3
        },
        "PlatformSummon": {
          "label": "Ignore the underfoot summon refusal",
          "type": "bool",
          "default": "0",
          "true": "1",
          "false": "0",
          "help": "Summoning while standing on something the game flags as a platform is refused with \"Cannot summon here.\", including Abyss Nexus teleport circles. Off by default: the reading comes from the disassembly and one report rather than a played test, and turning it on also lets a mount be summoned onto a moving platform anywhere in the game.",
          "order": 4
        },
        "BlockedSummon": {
          "label": "Ignore the something-in-the-way summon refusal",
          "type": "bool",
          "default": "1",
          "true": "1",
          "false": "0",
          "help": "After the region rule the summon validator checks a small box around you and refuses with \"You cannot do that here.\" when anything solid is in it. On the Abyss Nexus that refuses every mount, the Wyvern included. On, that refusal never happens, which also lets a mount be called where the game thinks it has no room.",
          "order": 5
        },
        "TownFlight": {
          "label": "Ignore the town dismount",
          "type": "bool",
          "default": "1",
          "true": "1",
          "false": "0",
          "help": "Flying low over a town, off the road, dismounts you with \"Cannot ride the mount in town.\" On, the road half of that rule always answers yes, so it can never fire. It reaches that one rule and nothing else; the in-town half is left alone because 23 other rows use it for bounty escalation and trade pricing.",
          "order": 6
        },
        "BlackstarStays": {
          "label": "Keep Blackstar from flying off",
          "type": "bool",
          "default": "1",
          "true": "1",
          "false": "0",
          "help": "Blackstar flies off about 30 seconds after he lands. On, the one action his AI uses to take off is refused and nothing else changes: you can still ride him, and summoning him again still works. Any value other than 0 here means on.",
          "order": 7
        },
        "BlackstarCooldown": {
          "label": "Blackstar's summon cooldown",
          "type": "float",
          "default": "0",
          "help": [
            "Blackstar's summon cooldown in seconds. The game's table gives him 3600, an hour. Only his row is written; every other mount keeps its own cooldown.",
            "0 removes it. A cooldown that was already running when the game started keeps the end time it began with, so 0 also lets him through the one check that refuses for a cooldown. -1 leaves the table alone, the game's value or another mod's. Any other number is that many seconds for a cooldown that starts afterwards; only 0 has been played."
          ],
          "order": 8
        },
        "Probe": {
          "label": "Research mode",
          "type": "bool",
          "default": "0",
          "true": "1",
          "false": "0",
          "advanced": true,
          "help": "Hooks every mount-related condition and reads the [sites], [patch] and [watch] sections below. Not needed for the mod to work, and the log becomes large.",
          "order": 9
        },
        "AboveCeiling": {
          "label": "Research: allow above a height",
          "type": "float",
          "default": "0",
          "advanced": true,
          "help": "Only with Probe on: answers a region refusal above this height as allowed. 0 is off, -1 is any height, a positive number is that height. NoFlyZones on already makes this moot.",
          "order": 10
        },
        "SummonAnywhere": {
          "label": "Research: allow any summon gate",
          "type": "bool",
          "default": "0",
          "true": "1",
          "false": "0",
          "advanced": true,
          "help": "Only with Probe on: answers a refusing summon gate condition as allowed. Not a fix: with a mount already out this forces its ground check to yes and produces \"Cannot summon mount while it's on the ground\".",
          "order": 11
        },
        "GroundCheck": {
          "label": "Research: ground-check distance",
          "type": "float",
          "default": "0",
          "hidden": true,
          "advanced": true,
          "help": "Only with Probe on: overrides the vehicleinfo ground-check distance the game uses. 0 leaves the game's own value alone. Not written into the shipped ini; add the key by hand under [settings] to use it.",
          "order": 12
        },
        "LandedTimeout": {
          "label": "Retired: old Blackstar timer",
          "type": "bool",
          "default": "0",
          "true": "1",
          "false": "0",
          "hidden": true,
          "readonly": true,
          "help": "Retired in 1.1.6. Up to 1.1.5 this set Blackstar's ground-check distance in characterinfo, which turned out to change nothing about when he takes off. BlackstarStays replaced it. Setting this now only makes the log note that an old value is present; it does nothing else.",
          "order": 13
        }
      }
    },
    "sites": {
      "label": "Research: hooks",
      "hidden": true,
      "advanced": true,
      "description": "Only read with Probe on. Hooks an arbitrary function by address and logs every call: caller, arguments, return value. Used to find the patches above; not needed to run the mod.",
      "order": 12,
      "keys": {}
    },
    "patch": {
      "label": "Research: byte patches",
      "hidden": true,
      "advanced": true,
      "description": "Only read with Probe on. Writes raw bytes at startup and restores them on unload.",
      "order": 13,
      "keys": {}
    },
    "watch": {
      "label": "Research: memory watches",
      "hidden": true,
      "advanced": true,
      "description": "Only read with Probe on. Logs bytes at startup and again whenever they change.",
      "order": 14,
      "keys": {}
    }
  }
}
